{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": [
    {
      "key": "NEXT_PUBLIC_SPLITWISE_API_KEY",
      "description": "Splitwise API key (SENSITIVE)",
      "value": "",
      "type": "secret"
    },
    {
      "key": "DATABASE_URL",
      "description": "PostgreSQL connection string (optional, unused at runtime)",
      "value": "",
      "type": "secret"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": true
  },
  "redirects": [],
  "rewrites": [],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
