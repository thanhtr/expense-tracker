generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  account   String   @default("Unknown")
  merchant  String
  amount    Float
  note      String   @default("")
  type      String
  category  String   @default("")
  paidBy    String   @default("tung")
  dedupKey  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([account])
  @@index([type])
  @@index([paidBy])
  @@index([merchant])
  @@index([amount])
  @@index([type, date])
  @@index([category, date])
}

model Budget {
  id           Int      @id @default(autoincrement())
  category     String   @unique
  monthlyLimit Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuidelineBucket {
  id         Int      @id @default(autoincrement())
  bucket     String   @unique  // "needs" | "wants" | "savings"
  targetPct  Float             // e.g. 50.0
  categories String            // JSON-encoded string[]
  updatedAt  DateTime @updatedAt
}

model LearnedRule {
  id            Int      @id @default(autoincrement())
  normalizedKey String   @unique
  category      String
  learnedFrom   String
  learnedAt     DateTime @default(now())
  count         Int      @default(1)
  updatedAt     DateTime @updatedAt

}
