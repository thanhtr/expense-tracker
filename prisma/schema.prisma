generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id        Int                @id @default(autoincrement())
  date      DateTime           @db.Date
  account   String             @default("Unknown")
  merchant  String
  amount    Float
  note      String             @default("")
  type      String
  category  String             @default("")
  paidBy    String             @default("tung")
  tags      String[]           @default([])
  dedupKey  String?            @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  splits    TransactionSplit[]
  expenseLinks      TransactionLink[] @relation("ExpenseLinks")
  reimbursementLink TransactionLink?  @relation("ReimbursementLinks")

  @@index([date])
  @@index([category])
  @@index([account])
  @@index([type])
  @@index([paidBy])
  @@index([merchant])
  @@index([amount])
  @@index([type, date])
  @@index([category, date])
}

model TransactionSplit {
  id            Int         @id @default(autoincrement())
  transactionId Int
  category      String
  amount        Float
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model TransactionLink {
  id                         Int         @id @default(autoincrement())
  expenseTransactionId       Int
  reimbursementTransactionId Int         @unique
  expenseTransaction         Transaction @relation("ExpenseLinks", fields: [expenseTransactionId], references: [id], onDelete: Cascade)
  reimbursementTransaction   Transaction @relation("ReimbursementLinks", fields: [reimbursementTransactionId], references: [id], onDelete: Cascade)
  createdAt                  DateTime    @default(now())

  @@index([expenseTransactionId])
}

model Budget {
  id           Int      @id @default(autoincrement())
  category     String   @unique
  monthlyLimit Float
  rollover     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuidelineBucket {
  id         Int      @id @default(autoincrement())
  bucket     String   @unique  // "needs" | "wants" | "savings"
  targetPct  Float             // e.g. 50.0
  categories String            // JSON-encoded string[]
  updatedAt  DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SavingsGoal {
  id             Int      @id @default(autoincrement())
  name           String
  targetAmount   Float
  currentAmount  Float    @default(0)
  targetDate     DateTime @db.Date
  linkedCategory String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Asset {
  id         Int      @id @default(autoincrement())
  name       String
  type       String   // "bank" | "investment" | "property" | "crypto" | "liability"
  balance    Float
  recordedAt DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([recordedAt])
  @@index([type])
}

model LearnedRule {
  id            Int      @id @default(autoincrement())
  normalizedKey String   @unique
  category      String
  learnedFrom   String
  learnedAt     DateTime @default(now())
  count         Int      @default(1)
  updatedAt     DateTime @updatedAt

}

model AssetSnapshot {
  id         Int      @id @default(autoincrement())
  assetId    Int
  name       String
  type       String
  balance    Float
  recordedAt DateTime @db.Date
  createdAt  DateTime @default(now())

  @@index([recordedAt])
  @@index([assetId])
}

model RecurringExclusion {
  id        Int      @id @default(autoincrement())
  type      String   // 'category' | 'merchant'
  value     String
  createdAt DateTime @default(now())

  @@unique([type, value])
}

model BankConnection {
  id           Int       @id @default(autoincrement())
  aspspId      String
  aspspName    String
  sessionId    String?   @unique
  accountId    String?
  accountLabel String
  owner        String    @default("tung")
  status       String    @default("pending")
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model HouseholdMember {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique  // stored as paidBy on transactions (lowercase, no spaces)
  createdAt DateTime @default(now())
}

model BankProfile {
  id            Int      @id @default(autoincrement())
  fingerprint   String   @unique
  bankLabel     String
  columnMapping Json
  isBuiltIn     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FireConfig {
  id                    Int      @id @default(autoincrement())
  dateOfBirth           String   @default("1990-05-15")
  retirementAge         Int      @default(50)
  mortgageEndAge        Int      @default(60)
  pensionAge            Int      @default(68)
  lifeExpectancy        Int      @default(95)
  emergencyFundMonths   Float    @default(6)
  monthlyContribution   Float    @default(3000)
  accumulationReturn    Float    @default(0.06)
  drawdownReturn        Float    @default(0.04)
  taxpayers             Int      @default(2)
  phase1aNetMonthly     Float    @default(4500)
  phase1bNetMonthly     Float    @default(3000)
  phase2NetMonthly      Float    @default(3000)
  pensionAccruedMonthly Float    @default(1330)
  lifeExpectancyCoef    Float    @default(0.90)
  pensionTaxRate        Float    @default(0.20)
  endBufferYears        Float    @default(2)
  returnVolatility      Float    @default(0.15)
  updatedAt             DateTime @updatedAt
}

model IncomeRule {
  id              Int      @id @default(autoincrement())
  label           String   @default("")
  merchantPattern String?
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([merchantPattern])
  @@index([category])
}

model PointsGoal {
  id         Int              @id @default(autoincrement())
  name       String
  unit       String           @default("Avios")
  note       String           @default("")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  balances   PointsBalance[]
  flights    PointsFlight[]
}

model PointsBalance {
  id         Int        @id @default(autoincrement())
  goalId     Int
  balance    Int
  // Untransferred Amex Membership Rewards balance at the time of this reading (Avios-unit goals
  // only); converted to its Avios equivalent at 17:10 in points-goal-service.ts.
  amexMr     Int        @default(0)
  recordedAt DateTime   @db.Date
  note       String     @default("")
  createdAt  DateTime   @default(now())
  goal       PointsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
}

model PointsFlight {
  id             Int        @id @default(autoincrement())
  goalId         Int
  label          String
  points         Int
  economyFareEur Float?
  neededBy       DateTime   @db.Date
  status         String     @default("planned") // "planned" | "redeemed"
  redeemedAt     DateTime?  @db.Date
  note           String     @default("")
  createdAt      DateTime   @default(now())
  goal           PointsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, neededBy])
}

model CardEarnRule {
  id              Int      @id @default(autoincrement())
  account         String   // 'Amex' | 'Finnair Visa'
  merchantPattern String
  classification  String   // 'normal' | 'bonus' | 'excluded'
  note            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([account])
  @@index([merchantPattern])
}

model FinnairPlusTier {
  id   Int    @id @default(1)
  tier String @default("basic") // 'basic' | 'silver'
}

model CsvImport {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  bank      String
  filename  String
  owner     String
  created   Int
  skipped   Int
  dateFrom  DateTime? @db.Date
  dateTo    DateTime? @db.Date
}
