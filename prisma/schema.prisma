generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id        Int                @id @default(autoincrement())
  date      DateTime           @db.Date
  account   String             @default("Unknown")
  merchant  String
  amount    Float
  note      String             @default("")
  type      String
  category  String             @default("")
  paidBy    String             @default("tung")
  tags      String[]           @default([])
  dedupKey  String?            @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  splits    TransactionSplit[]

  @@index([date])
  @@index([category])
  @@index([account])
  @@index([type])
  @@index([paidBy])
  @@index([merchant])
  @@index([amount])
  @@index([type, date])
  @@index([category, date])
}

model TransactionSplit {
  id            Int         @id @default(autoincrement())
  transactionId Int
  category      String
  amount        Float
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model Budget {
  id           Int      @id @default(autoincrement())
  category     String   @unique
  monthlyLimit Float
  rollover     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuidelineBucket {
  id         Int      @id @default(autoincrement())
  bucket     String   @unique  // "needs" | "wants" | "savings"
  targetPct  Float             // e.g. 50.0
  categories String            // JSON-encoded string[]
  updatedAt  DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SavingsGoal {
  id             Int      @id @default(autoincrement())
  name           String
  targetAmount   Float
  currentAmount  Float    @default(0)
  targetDate     DateTime @db.Date
  linkedCategory String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Asset {
  id         Int      @id @default(autoincrement())
  name       String
  type       String   // "bank" | "investment" | "property" | "crypto" | "liability"
  balance    Float
  recordedAt DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([recordedAt])
  @@index([type])
}

model LearnedRule {
  id            Int      @id @default(autoincrement())
  normalizedKey String   @unique
  category      String
  learnedFrom   String
  learnedAt     DateTime @default(now())
  count         Int      @default(1)
  updatedAt     DateTime @updatedAt

}

model AssetSnapshot {
  id         Int      @id @default(autoincrement())
  assetId    Int
  name       String
  type       String
  balance    Float
  recordedAt DateTime @db.Date
  createdAt  DateTime @default(now())

  @@index([recordedAt])
  @@index([assetId])
}
