generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id        Int                @id @default(autoincrement())
  date      DateTime           @db.Date
  account   String             @default("Unknown")
  merchant  String
  amount    Float
  note      String             @default("")
  type      String
  category  String             @default("")
  paidBy    String             @default("tung")
  tags      String[]           @default([])
  dedupKey  String?            @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  splits    TransactionSplit[]

  @@index([date])
  @@index([category])
  @@index([account])
  @@index([type])
  @@index([paidBy])
  @@index([merchant])
  @@index([amount])
  @@index([type, date])
  @@index([category, date])
}

model TransactionSplit {
  id            Int         @id @default(autoincrement())
  transactionId Int
  category      String
  amount        Float
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model Budget {
  id           Int      @id @default(autoincrement())
  category     String   @unique
  monthlyLimit Float
  rollover     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuidelineBucket {
  id         Int      @id @default(autoincrement())
  bucket     String   @unique  // "needs" | "wants" | "savings"
  targetPct  Float             // e.g. 50.0
  categories String            // JSON-encoded string[]
  updatedAt  DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SavingsGoal {
  id             Int      @id @default(autoincrement())
  name           String
  targetAmount   Float
  currentAmount  Float    @default(0)
  targetDate     DateTime @db.Date
  linkedCategory String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Asset {
  id         Int      @id @default(autoincrement())
  name       String
  type       String   // "bank" | "investment" | "property" | "crypto" | "liability"
  balance    Float
  recordedAt DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([recordedAt])
  @@index([type])
}

model LearnedRule {
  id            Int      @id @default(autoincrement())
  normalizedKey String   @unique
  category      String
  learnedFrom   String
  learnedAt     DateTime @default(now())
  count         Int      @default(1)
  updatedAt     DateTime @updatedAt

}

model AssetSnapshot {
  id         Int      @id @default(autoincrement())
  assetId    Int
  name       String
  type       String
  balance    Float
  recordedAt DateTime @db.Date
  createdAt  DateTime @default(now())

  @@index([recordedAt])
  @@index([assetId])
}

model RecurringExclusion {
  id        Int      @id @default(autoincrement())
  type      String   // 'category' | 'merchant'
  value     String
  createdAt DateTime @default(now())

  @@unique([type, value])
}

model BankConnection {
  id           Int       @id @default(autoincrement())
  aspspId      String
  aspspName    String
  sessionId    String?   @unique
  accountId    String?
  accountLabel String
  owner        String    @default("tung")
  status       String    @default("pending")
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model HouseholdMember {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique  // stored as paidBy on transactions (lowercase, no spaces)
  createdAt DateTime @default(now())
}

model BankProfile {
  id            Int      @id @default(autoincrement())
  fingerprint   String   @unique
  bankLabel     String
  columnMapping Json
  isBuiltIn     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FireConfig {
  id                  Int      @id @default(autoincrement())
  dateOfBirth         String   @default("1990-05-15")
  retirementAge       Int      @default(50)
  mortgageEndAge      Int      @default(60)
  pensionAge          Int      @default(65)
  lifeExpectancy      Int      @default(95)
  monthlyContribution Float    @default(3000)
  accumulationReturn  Float    @default(0.06)
  drawdownReturn      Float    @default(0.04)
  capitalGainsTaxRate Float    @default(0.20)
  phase1aNetMonthly   Float    @default(4500)
  phase1bNetMonthly   Float    @default(3000)
  phase2NetMonthly    Float    @default(3000)
  pensionNetMonthly   Float    @default(1580)
  updatedAt           DateTime @updatedAt
}

model IncomeRule {
  id              Int      @id @default(autoincrement())
  label           String   @default("")
  merchantPattern String?
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([merchantPattern])
  @@index([category])
}
