# PostgreSQL database (Neon or any Postgres provider)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth — random 32+ char secret for signing session cookies
AUTH_SECRET=change-me-to-a-random-32-char-secret-at-minimum

# App password (single shared password for login)
AUTH_PASSWORD=change-me

# Anthropic API key — enables AI-based CSV format auto-detection for unknown banks
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
